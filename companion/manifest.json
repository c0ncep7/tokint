{
  "manifest_version": 3,
  "name": "TOKINT \u2014 IPFS shortcut",
  "version": "1.0.0",
  "description": "Type ipfs, then Tab, to open content using your tokint gateway.",
  "minimum_chrome_version": "109",
  "key": "",
  "omnibox": {
    "keyword": "ipfs"
  },
  "background": {
    "service_worker": "ipfs-background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/tokint-16.png",
    "32": "icons/tokint-32.png",
    "48": "icons/tokint-48.png",
    "128": "icons/tokint-128.png"
  }
}
